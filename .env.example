# npm run setup creates random values in .env.local. Never commit .env.local.
# Historical name: first-run setup code, not a shared login password.
SHOAL_OWNER_PASSWORD=replace-with-a-long-random-setup-code
SHOAL_SECRET_KEY=replace-with-32-random-bytes-encoded-as-base64
BUZZ_RUNNER_TOKEN=replace-with-a-long-random-token

# Defaults: one local team workspace, SQLite + files. Paths are relative to the repo.
SHOAL_DATA_DIR=.shoal
# DATABASE_URL=file:./.shoal/shoal.sqlite
# DATABASE_URL=postgresql://shoal:password@localhost:5432/shoal
SHOAL_SOURCES_DIR=.shoal/sources
PORT=3000
SHOAL_BIND=127.0.0.1
# npm run lan adds HTTPS; the internal app stays on loopback.
# SHOAL_HTTPS_PORT=8443
# SHOAL_LAN_BIND=0.0.0.0
# SHOAL_LAN_HOSTS=192.168.1.10,shoal.local
# SHOAL_WORK_DIR=.shoal/work
# Task directories are selected relative to this root; existing folders need admin assignment.
# SHOAL_WORKSPACE_ROOT=.shoal/workspaces
# Build once: docker build -f runner/Dockerfile.sandbox -t shoal-workspace:local .
# SHOAL_SANDBOX_IMAGE=shoal-workspace:local
# SHOAL_SANDBOX_CPUS=2
# SHOAL_SANDBOX_MEMORY=2g
BUZZ_API=http://127.0.0.1:3000
BUZZ_CONCURRENCY=2
# Set to 1 behind HTTPS. The proxy must preserve the public Host header.
# SHOAL_COOKIE_SECURE=1

# Save model endpoints through Habitats > Models.
# Optional env-configured retrieval services; Habitats > Models connections take precedence.
# BUZZ_EMBED_URL=http://127.0.0.1:8001/v1
# BUZZ_EMBED_MODEL=
# BUZZ_EMBED_TOKEN=
# BUZZ_RERANK_URL=http://127.0.0.1:8002
# BUZZ_RERANK_MODEL=
# BUZZ_RERANK_TOKEN=
# Display name for this runtime host in Habitats.
# BUZZ_NODE_NAME=Your runtime

# Optional native agent runtime for OpenClaw tools and delegation.
# Direct model script tools instead use Docker on the runner; see README.md.
# BUZZ_OPENCLAW_URL=http://127.0.0.1:18789
# BUZZ_OPENCLAW_TOKEN=
# BUZZ_OPENCLAW_AGENT=main
# SHOAL_EXTERNAL_RUNNER=1
# Paired terminal device token (scripts/device.mjs writes it to .env.device on that machine).
# SHOAL_DEVICE_TOKEN=

# Optional S3-compatible document storage. AWS credentials stay server-side.
# SHOAL_S3_BUCKET=shoal-documents
# SHOAL_S3_ENDPOINT=https://your-object-storage.example
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional Google Drive OAuth web client. May also be configured in Data > Add source.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# OpenAI and Claude API keys are entered per user/shared connection in the app.
