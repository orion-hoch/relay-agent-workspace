{
  "name": "shoal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "runner": "node --env-file=.env.local runner/buzz-runner.mjs",
    "typecheck": "tsc --noEmit",
    "ingest": "node --env-file=.env.local --import tsx runner/ingest.ts",
    "migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "runtime:config": "node --env-file=.env.local --import tsx scripts/runtime-config.ts",
    "lan": "node scripts/start.mjs --lan",
    "dev:lan": "node scripts/start.mjs --dev --lan",
    "account:reset": "node --env-file=.env.local --import tsx scripts/reset-account.ts",
    "device": "node scripts/device.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.31.0",
    "mammoth": "1.12.3",
    "mysql2": "3.24.4",
    "next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "undici": "7.29.1"
  },
  "license": "Apache-2.0"
}
